<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fitsSystemWindows="true">

    <!-- ─── AppBar ─────────────────────────────────────────── -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:fitsSystemWindows="true"
        app:elevation="2dp">

        <!-- Main toolbar row -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Title block -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.01" />

                    <TextView
                        android:id="@+id/tvStorageInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calculating…"
                        android:textColor="@color/text_secondary"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <!-- Grid/List toggle -->
                <ImageButton
                    android:id="@+id/btnToggleView"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_grid"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/grid_view"
                    android:tint="@color/text_secondary" />

                <!-- Sort -->
                <ImageButton
                    android:id="@+id/btnSort"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_sort"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/sort_by"
                    android:tint="@color/text_secondary" />

            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- Search row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/searchView"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/bg_search_bar"
                app:iconifiedByDefault="false"
                app:queryHint="@string/action_search"
                app:searchIcon="@drawable/ic_search"
                app:closeIcon="@drawable/ic_close"
                app:searchHintIcon="@null" />

        </LinearLayout>

        <!-- Breadcrumb strip -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBreadcrumb"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:background="@color/surface_variant" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ─── Content ──────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- File list / grid -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_folder"
                    android:tint="@color/text_hint"
                    android:alpha="0.5" />

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/empty_folder"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFiles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:scrollbars="none" />

        </FrameLayout>

        <!-- ─── Bottom Quick Nav ─────────────────────────────── -->
        <LinearLayout
            android:id="@+id/bottomQuickNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/surface"
            android:elevation="8dp"
            android:padding="0dp">

            <!-- Thin top divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Bottom nav as horizontal scrollable row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/surface"
            android:elevation="4dp"
            android:scrollbars="none"
            android:fadingEdgeLength="24dp">

            <LinearLayout
                android:id="@+id/llNavBar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:divider="@null">

                <!-- Home -->
                <LinearLayout
                    android:id="@+id/navHome"
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_home_nav"
                        android:tint="@color/accent" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_home"
                        android:textSize="9.5sp"
                        android:textColor="@color/accent"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Downloads -->
                <LinearLayout
                    android:id="@+id/navDownloads"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_folder_nav"
                        android:tint="@color/bottom_nav_unselected" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_downloads"
                        android:textSize="9.5sp"
                        android:textColor="@color/bottom_nav_unselected"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Images -->
                <LinearLayout
                    android:id="@+id/navImages"
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_image"
                        android:tint="@color/bottom_nav_unselected" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_images"
                        android:textSize="9.5sp"
                        android:textColor="@color/bottom_nav_unselected"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Videos -->
                <LinearLayout
                    android:id="@+id/navVideos"
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_video"
                        android:tint="@color/bottom_nav_unselected" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_videos"
                        android:textSize="9.5sp"
                        android:textColor="@color/bottom_nav_unselected"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- App Data -->
                <LinearLayout
                    android:id="@+id/navAppData"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_data_nav"
                        android:tint="@color/bottom_nav_unselected" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_data"
                        android:textSize="9.5sp"
                        android:textColor="@color/bottom_nav_unselected"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNewFolder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="72dp"
        android:src="@drawable/ic_create_folder"
        android:contentDescription="New folder"
        app:backgroundTint="@color/accent"
        app:tint="@android:color/white"
        app:elevation="6dp"
        app:fabSize="normal" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
